<section
  class="tab {{tabs.details.id}} {{tabs.details.cssClass}}"
  data-tab="{{tabs.details.id}}"
  data-group="{{tabs.details.group}}"
>
  <section class="sheet-body">
    {{#if (eq item.type 'armor')}}
    <div class="grid grid-1col">
      <div class="resource">
        <label class="resource-label">{{localize "SWORDS_WIZARDRY.Item.Armor.Attributes.EffectOnAC"}}</label>
        <input type="text" name="system.effectOnAC" value="{{system.effectOnAC}}" data-dtype="String"/>
      </div>
    </div>
    {{/if}}
    {{#if (eq item.type 'feature')}}
    <div class="grid grid-3col">
      <div class="resource">
        <label class="resource-label">{{localize "SWORDS_WIZARDRY.Item.Item.Attributes.RollFormula"}}</label>
        <input type="text" name="system.formula" value="{{system.formula}}" data-dtype="String"/>
      </div>
      <div class="resource">
        <label class="resource-label">{{localize "SWORDS_WIZARDRY.Item.Item.Attributes.Target"}}</label>
        <input type="text" name="system.target" value="{{system.target}}" data-dtype="String"/>
      </div>
      <div class="resource">
        <label class="resource-label">{{localize "SWORDS_WIZARDRY.Item.Item.Attributes.TargetType"}}</label>
        <select name="system.targetType" value="{{system.targetType}}" data-dtype="String">
          <option value="ascending" {{# if (eq system.targetType 'ascending')}}selected{{/if}}>{{localize "SWORDS_WIZARDRY.Item.Item.Attributes.TargetTypeAsc"}}</option>
          <option value="descending" {{# if (eq system.targetType 'descending')}}selected{{/if}}>{{localize "SWORDS_WIZARDRY.Item.Item.Attributes.TargetTypeDes"}}</option>
        </select>
      </div>
    </div>
    {{/if}}
    {{#if (eq item.type 'item')}}
    <div class="grid grid-4col">
      <div class="resource">
        <label class="resource-label">{{localize "SWORDS_WIZARDRY.Item.Item.Attributes.Usable"}}</label>
        <input type="checkbox" name="system.usable" class="checkbox-small align-self-center" {{checked system.usable}}/>
      </div>
      <div class="resource">
        <label class="resource-label">{{localize "SWORDS_WIZARDRY.Item.Item.Attributes.Consumable"}}</label>
        <input type="checkbox" name="system.consumable" class="checkbox-small align-self-center" {{checked system.consumable}}{{#unless system.usable}} disabled{{/unless}}/>
      </div>
      <div class="resource">
        <label class="resource-label">{{localize "SWORDS_WIZARDRY.Item.Spell.RollType"}}</label>
        <select name="system.rollType"{{#unless system.usable}} disabled{{/unless}}>
          <option value="none" {{#if (eq system.rollType 'none')}}selected{{/if}}>{{localize "SWORDS_WIZARDRY.Item.Spell.RollNone"}}</option>
          <option value="damage" {{#if (eq system.rollType 'damage')}}selected{{/if}}>{{localize "SWORDS_WIZARDRY.Item.Spell.RollDamage"}}</option>
          <option value="healing" {{#if (eq system.rollType 'healing')}}selected{{/if}}>{{localize "SWORDS_WIZARDRY.Item.Spell.RollHealing"}}</option>
        </select>
      </div>

      <div class="resource">
        <label class="resource-label">{{localize "SWORDS_WIZARDRY.Item.Item.Attributes.RollFormula"}}</label>
        <input type="text" name="system.formula" value="{{system.formula}}" data-dtype="String"{{#unless system.usable}} disabled{{/unless}}/>
      </div>
    </div>
    {{/if}}
    {{#if (eq item.type 'spell')}}
    <div class="grid grid-3col">
      <div class="resource">
        <label class="resource-label">{{localize "SWORDS_WIZARDRY.Item.Spell.Level"}}</label>
        <input type="text" name="system.spellLevel" value="{{system.spellLevel}}" data-dtype="String"/>
      </div>
      <div class="resource">
        <label class="resource-label">{{localize "SWORDS_WIZARDRY.Item.Spell.Range"}}</label>
        <input type="text" name="system.range" value="{{system.range}}" data-dtype="String"/>
      </div>
      <div class="resource">
        <label class="resource-label">{{localize "SWORDS_WIZARDRY.Item.Spell.Duration"}}</label>
        <input type="text" name="system.duration" value="{{system.duration}}" data-dtype="String"/>
      </div>
    </div>
    <div class="grid grid-2col">
      <div class="resource">
        <label class="resource-label">{{localize "SWORDS_WIZARDRY.Item.Spell.RollType"}}</label>
        <select name="system.rollType">
          <option value="none" {{#if (eq system.rollType 'none')}}selected{{/if}}>{{localize "SWORDS_WIZARDRY.Item.Spell.RollNone"}}</option>
          <option value="damage" {{#if (eq system.rollType 'damage')}}selected{{/if}}>{{localize "SWORDS_WIZARDRY.Item.Spell.RollDamage"}}</option>
          <option value="healing" {{#if (eq system.rollType 'healing')}}selected{{/if}}>{{localize "SWORDS_WIZARDRY.Item.Spell.RollHealing"}}</option>
        </select>
      </div>
      <div class="resource">
        <label class="resource-label">{{localize "SWORDS_WIZARDRY.Item.Spell.RollFormula"}}</label>
        <input type="text" name="system.formula" value="{{system.formula}}" data-dtype="String" placeholder="(@lvl)d6"{{#if (eq system.rollType 'none')}} disabled{{/if}}/>
      </div>
      <div class="resource">
        <label class="resource-label">{{localize "SWORDS_WIZARDRY.Item.Spell.RequiresSave"}}</label>
        <input type="checkbox" name="system.requiresSave" class="checkbox-small align-self-center" {{checked system.requiresSave}}/>
      </div>
      <div class="resource">
        <label class="resource-label">{{localize "SWORDS_WIZARDRY.Item.Spell.SaveEffect"}}</label>
        <select name="system.saveEffect" data-dtype="String" {{#unless system.requiresSave}}disabled{{/unless}}>
          <option value="half" {{#if (eq system.saveEffect 'half')}}selected{{/if}}>{{localize "SWORDS_WIZARDRY.Chat.HalfEffect"}}</option>
          <option value="negate" {{#if (eq system.saveEffect 'negate')}}selected{{/if}}>{{localize "SWORDS_WIZARDRY.Chat.NegatesSpell"}}</option>
        </select>
      </div>
    </div>
    {{/if}}
    {{#if (eq item.type 'weapon')}}
    <div class="grid grid-3col">
      <div class="resource">
        <label class="resource-label">{{localize "SWORDS_WIZARDRY.Item.Weapon.Attributes.ToHitModifier"}}</label>
        <input type="text" name="system.modifier" value="{{system.modifier}}" data-dtype="String"/>
      </div>
      <div class="resource">
        <label class="resource-label">{{localize "SWORDS_WIZARDRY.Item.Weapon.Attributes.DamageRollFormula"}}</label>
        <input type="text" name="system.damageFormula" value="{{system.damageFormula}}" data-dtype="String"/>
      </div>
      <div class="resource">
        <label class="resource-label">{{localize "SWORDS_WIZARDRY.Item.Weapon.Attributes.SpecialDamage"}}</label>
        <input type="text" name="system.specialDamage" value="{{system.specialDamage}}" data-dtype="String"/>
      </div>
      <div class="resource">
        <label class="resource-label">{{localize "SWORDS_WIZARDRY.Item.Weapon.Attributes.Missile"}}</label>
        <input type="checkbox" name="system.missile" class="checkbox-small align-self-center" {{checked system.missile}}/>
      </div>
      <div class="resource">
        <label class="resource-label">{{localize "SWORDS_WIZARDRY.Item.Weapon.Attributes.Range"}}</label>
        <input type="text" name="system.range" value="{{system.range}}" data-dtype="Number"/>
      </div>
      <div class="resource">
        <label class="resource-label">{{localize "SWORDS_WIZARDRY.Item.Weapon.Attributes.RateOfFire"}}</label>
        <input type="text" name="system.rateOfFire" value="{{system.rateOfFire}}" data-dtype="Number"/>
      </div>
    </div>
    {{/if}}
    <div class="grid grid-1col">
      {{#if editable}}
      <prose-mirror
        name="system.description"
        button="true"
        editable="{{editable}}"
        toggled="false"
        value="{{system.description}}"
      >
        {{{system.description}}}
      </prose-mirror>
      {{else}}
      {{{system.description}}}
      {{/if}}
    </div>
  </section>
</section>
