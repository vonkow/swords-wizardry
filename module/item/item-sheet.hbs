<section class="{{cssClass}}" autocomplete="off">
  <header class="sheet-header">
    <img
      class="profile-img"
      src="{{item.img}}"
      data-action="editImage"
      data-field="img"
      title="{{item.name}}"
    />
    <div class="header-fields">
      <h2 class="charname">
        <input name="name" type="text" value="{{item.name}}" placeholder={{localize "SWORDS_WIZARDRY.Item.Item.Name"}}/>
      </h2>
      {{#if (or (or (eq item.type 'item') (eq item.type 'weapon')) (eq item.type 'armor'))}}
      <div class="grid grid-3col">
        <div class="resource">
          <label class="resource-label">{{localize "SWORDS_WIZARDRY.Item.Item.Quantity"}}</label>
          <input type="text" name="system.quantity" value="{{system.quantity}}" data-dtype="Number"/>
        </div>
        <div class="resource">
          <label class="resource-label">{{localize "SWORDS_WIZARDRY.Item.Item.Weight"}}</label>
          <input type="text" name="system.weight" value="{{system.weight}}" data-dtype="Number"/>
        </div>
        <div class="resource">
          <label class="resource-label">{{localize "SWORDS_WIZARDRY.Item.Item.Gold"}}</label>
          <input type="text" name="system.gp" value="{{system.gp}}" data-dtype="Number"/>
        </div>
      </div>
      {{/if}}
    </div>
  </header>
  <section class="sheet-body">
    {{#if (eq item.type 'armor')}}
    <div class="grid grid-1col">
      <div class="resource">
        <label class="resource-label">{{localize "SWORDS_WIZARDRY.Item.Armor.Attributes.EffectOnAC"}}</label>
        <input type="text" name="system.effectOnAC" value="{{system.effectOnAC}}" data-dtype="String"/>
      </div>
    </div>
    {{/if}}
    {{#if (eq item.type 'feature')}}
    <div class="grid grid-3col">
      <div class="resource">
        <label class="resource-label">{{localize "SWORDS_WIZARDRY.Item.Item.Attributes.RollFormula"}}</label>
        <input type="text" name="system.formula" value="{{system.formula}}" data-dtype="String"/>
      </div>
      <div class="resource">
        <label class="resource-label">{{localize "SWORDS_WIZARDRY.Item.Item.Attributes.Target"}}</label>
        <input type="text" name="system.target" value="{{system.target}}" data-dtype="String"/>
      </div>
      <div class="resource">
        <label class="resource-label">{{localize "SWORDS_WIZARDRY.Item.Item.Attributes.TargetType"}}</label>
        <select name="system.targetType" value="{{system.targetType}}" data-dtype="String">
          <option value="ascending" {{# if (eq system.targetType 'ascending')}}selected{{/if}}>{{localize "SWORDS_WIZARDRY.Item.Item.Attributes.TargetTypeAsc"}}</option>
          <option value="descending" {{# if (eq system.targetType 'descending')}}selected{{/if}}>{{localize "SWORDS_WIZARDRY.Item.Item.Attributes.TargetTypeDes"}}</option>
        </select>
      </div>
    </div>
    {{/if}}
    {{#if (eq item.type 'item')}}
    <div class="grid grid-1col">
      <div class="resource">
        <label class="resource-label">{{localize "SWORDS_WIZARDRY.Item.Item.Attributes.RollFormula"}}</label>
        <input type="text" name="system.formula" value="{{system.formula}}" data-dtype="String"/>
      </div>
    </div>
    {{/if}}
    {{#if (eq item.type 'spell')}}
    <div class="grid grid-2col">
      <div class="resource">
        <label class="resource-label">{{localize "SWORDS_WIZARDRY.Item.Spell.Level"}}</label>
        <input type="text" name="system.spellLevel" value="{{system.spellLevel}}" data-dtype="Text"/>
      </div>
      <div class="resource">
        <label class="resource-label">{{localize "SWORDS_WIZARDRY.Item.Spell.Range"}}</label>
        <input type="text" name="system.range" value="{{system.range}}" data-dtype="Text"/>
      </div>
    </div>
    <div class="grid grid-1col">
      <div class="resource">
        <label class="resource-label">{{localize "SWORDS_WIZARDRY.Item.Spell.Duration"}}</label>
        <input type="text" name="system.duration" value="{{system.duration}}" data-dtype="Text"/>
      </div>
    </div>
    <div class="grid grid-2col">
      <div class="resource">
        <label class="resource-label">{{localize "SWORDS_WIZARDRY.Item.Spell.RollFormula"}}</label>
        <input type="text" name="system.formula" value="{{system.formula}}" data-dtype="String" placeholder="(@lvl)d6"/>
      </div>
      <div class="resource">
        <label class="resource-label">{{localize "SWORDS_WIZARDRY.Item.Spell.EffectType"}}</label>
        <select name="system.effectType" data-dtype="String">
          <option value="none" {{#if (eq system.effectType 'none')}}selected{{/if}}>{{localize "SWORDS_WIZARDRY.Item.Spell.EffectNone"}}</option>
          <option value="damage" {{#if (eq system.effectType 'damage')}}selected{{/if}}>{{localize "SWORDS_WIZARDRY.Item.Spell.EffectDamage"}}</option>
          <option value="healing" {{#if (eq system.effectType 'healing')}}selected{{/if}}>{{localize "SWORDS_WIZARDRY.Item.Spell.EffectHealing"}}</option>
        </select>
      </div>
      <div class="resource">
        <label class="resource-label">{{localize "SWORDS_WIZARDRY.Item.Spell.RequiresSave"}}</label>
        <input type="checkbox" name="system.requiresSave" class="checkbox-small align-self-center" {{checked system.requiresSave}}/>
      </div>
      <div class="resource">
        <label class="resource-label">{{localize "SWORDS_WIZARDRY.Item.Spell.SaveEffect"}}</label>
        <select name="system.saveEffect" data-dtype="String">
          <option value="half" {{#if (eq system.saveEffect 'half')}}selected{{/if}}>{{localize "SWORDS_WIZARDRY.Chat.HalfEffect"}}</option>
          <option value="negate" {{#if (eq system.saveEffect 'negate')}}selected{{/if}}>{{localize "SWORDS_WIZARDRY.Chat.NegatesSpell"}}</option>
        </select>
      </div>
    </div>
    <div>
      <ol class="items-list effects-list">
        <li 
          class="items-header flexrow" 
          data-effect-type="{{section.type}}" 
          data-parent-id="{{@root.item.id}}"
        >
          <h3 class="item-name effect-name flexrow">{{localize section.label}}</h3>
          <div class="item-controls effect-controls flexrow">
            <a 
              class="effect-control" 
              data-action="effectCreate" 
              title="{{localize 'SWORDS_WIZARDRY.Effect.Create' 
              type="Effect"}}"
            >
              <i class="fas fa-plus"></i> {{localize "SWORDS_WIZARDRY.Effect.Create"}}
            </a>
          </div>
        </li>
        {{#each effects as |effect|}}
        <li class="item effect flexrow" data-effect-id="{{effect.id}}" data-parent-id="{{effect.parent.id}}">
          <div class="item-name effect-name flexrow">
            <img class="item-image" src="{{effect.icon}}"/>
            <h4>{{effect.name}}</h4>
          </div>
          <div class="item-controls effect-controls flexrow">
            <a
              class="effect-control"
              data-action="effectEdit"
              data-id="{{effect._id}}"
              title="{{localize 'SWORDS_WIZARDRY.Effect.Update' type="Effect"}}"
            >
              <i class="fas fa-edit"></i>
            </a>
            <a
              class="effect-control" 
              data-action="effectDelete" 
              data-id="{{effect._id}}" 
              title="{{localize 'SWORDS_WIZARDRY.Effect.Delete' type="Effect"}}"
            >
              <i class="fas fa-trash"></i>
            </a>
          </div>
        </li>
        {{/each}}
      </ol>
    </div>
    {{/if}}
    {{#if (eq item.type 'weapon')}}
    <div class="grid grid-3col">
      <div class="resource">
        <label class="resource-label">{{localize "SWORDS_WIZARDRY.Item.Weapon.Attributes.ToHitModifier"}}</label>
        <input type="text" name="system.modifier" value="{{system.modifier}}" data-dtype="String"/>
      </div>
      <div class="resource">
        <label class="resource-label">{{localize "SWORDS_WIZARDRY.Item.Weapon.Attributes.DamageRollFormula"}}</label>
        <input type="text" name="system.damageFormula" value="{{system.damageFormula}}" data-dtype="String"/>
      </div>
      <div class="resource">
        <label class="resource-label">{{localize "SWORDS_WIZARDRY.Item.Weapon.Attributes.SpecialDamage"}}</label>
        <input type="text" name="system.specialDamage" value="{{system.specialDamage}}" data-dtype="String"/>
      </div>
      <div class="resource">
        <label class="resource-label">{{localize "SWORDS_WIZARDRY.Item.Weapon.Attributes.Missile"}}</label>
        <input type="checkbox" name="system.missile" class="checkbox-small align-self-center" {{checked system.missile}}/>
      </div>
      <div class="resource">
        <label class="resource-label">{{localize "SWORDS_WIZARDRY.Item.Weapon.Attributes.Range"}}</label>
        <input type="text" name="system.range" value="{{system.range}}" data-dtype="Number"/>
      </div>
      <div class="resource">
        <label class="resource-label">{{localize "SWORDS_WIZARDRY.Item.Weapon.Attributes.RateOfFire"}}</label>
        <input type="text" name="system.rateOfFire" value="{{system.rateOfFire}}" data-dtype="Number"/>
      </div>
    </div>
    {{/if}}
    <div class="grid grid-1col">
      {{#if editable}}
      <prose-mirror
        name="system.description"
        button="true"
        editable="{{editable}}"
        toggled="false"
        value="{{system.description}}"
      >
        {{{system.description}}}
      </prose-mirror>
      {{else}}
      {{{system.description}}}
      {{/if}}
    </div>
  </section>
</section>
